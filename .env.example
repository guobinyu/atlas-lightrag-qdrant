# Default: real local Chinese embeddings + persistent Qdrant local engine.
# Copy to .env only when changing defaults. Restart the app after changes.
WORKSPACE=silk_culture_demo
QDRANT_MODE=local
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
SEED_DEMO=true
SAMPLE_LIMIT=2000
REQUEST_TIMEOUT=60

# To use a /v1/embeddings-compatible HTTP endpoint, set provider=http,
# its exact model identifier, and the dimension used during indexing.
EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
EMBEDDING_API_KEY=
QUERY_PREFIX=
DOCUMENT_PREFIX=

# Optional absolute paths. Keep different models/workspaces separate.
# LAB_DATA_DIR=/absolute/path/to/retrieval-lab-data
# LIGHTRAG_WORKING_DIR=/absolute/path/to/existing/lightrag-working-dir

# Existing Qdrant Server + LightRAG workspace:
# QDRANT_MODE=server
# SEED_DEMO=false
# WORKSPACE=your_workspace
# LIGHTRAG_WORKING_DIR=/absolute/path/to/lightrag-working-dir
# Stop other writers to this workspace while observing it.
